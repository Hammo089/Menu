 <queries><intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.HOME"/></intent></queries>
 <application android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="Blanco TV" android:icon="@drawable/blanco_logo" android:banner="@drawable/blanco_logo" android:allowBackup="false" android:usesCleartextTraffic="false" android:hardwareAccelerated="true" android:supportsRtl="true">
